# Reliable Solana devnet RPC (Helius / QuickNode / Triton).
# The public cluster RPC drops Arcium transactions — do not use it for play.
NEXT_PUBLIC_SOLANA_RPC=https://<helius-or-equivalent>/devnet

# Base58 mint-authority secret for the HHC faucet (`app/app/api/faucet`).
# Server-side only. Never prefix this with NEXT_PUBLIC_.
FAUCET_SECRET=
